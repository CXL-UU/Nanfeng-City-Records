<!-- 编辑工具条 -->
<div id="toolbar" class="glass edit-only">
  <button class="px-btn small" data-act="save" type="button">💾 保存</button>
  <button class="px-btn small gray" data-act="bg" type="button">🖼 设置背景图</button>
  <button class="px-btn small gray" data-act="export" type="button">⬇ 导出HTML</button>
  <button class="px-btn small danger" data-act="reset" type="button">↺ 重置</button>
</div>
<button id="authBtn" class="px-btn small gray" type="button" title="编辑登录" aria-label="编辑登录">🔑</button>

<script>
(function(){
  'use strict';
  /* ============ 配置 ============ */
  var PASSWORD = 'mc2026';            // 修改密码请改这里
  var KEY = 'mc_showcase_v2';

  var $ = function(s,r){return (r||document).querySelector(s)};
  var $$ = function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s))};
  var app = $('#app'), editing = false;

  /* ============ 工具 ============ */
  var toastTimer;
  function toast(msg, err){
    var t = $('#toast');
    t.textContent = msg;
    t.className = 'show' + (err ? ' err' : '');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function(){ t.className = ''; }, 1800);
  }
  function copyText(text){
    if(navigator.clipboard && window.isSecureContext){
      return navigator.clipboard.writeText(text).then(function(){return true},function(){return fallback()});
    }
    return Promise.resolve(fallback());
    function fallback(){
      var ta = document.createElement('textarea');
      ta.value = text; ta.style.cssText = 'position:fixed;opacity:0;top:0;left:0';
      document.body.appendChild(ta); ta.focus(); ta.select();
      var ok = false;
      try{ ok = document.execCommand('copy'); }catch(e){}
      ta.remove(); return ok;
    }
  }
  function esc(s){return String(s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}

  /* ============ 模板 ============ */
  function imgWrap(cls, alt){
    return '<div class="img-wrap '+(cls||'')+'">' +
      '<img src="" alt="'+esc(alt||'')+'" loading="lazy" referrerpolicy="no-referrer">' +
      '<button class="copy-btn" data-act="copy" type="button">⧉ 复制链接</button>' +
      '<button class="swap-btn edit-only" data-act="swap" type="button">✎ 换图</button></div>';
  }
  var delBtn = '<button class="px-btn small danger edit-only" data-act="del" type="button">🗑 删除</button>';
  var tpl = {
    mod: function(n){
      return '<article class="item glass">' + imgWrap('wide','模组截图') +
        '<h3 data-edit contenteditable="false">'+esc(n||'模组名称')+'</h3>' +
        '<label class="field"><span>组件码</span><input class="code" placeholder="待填写" readonly></label>' +
        '<label class="field price"><span>售价</span><input class="price-in" placeholder="¥ 0.00" readonly></label>' +
        delBtn + '</article>';
    },
    gal: function(n){
      return '<figure class="item glass">' + imgWrap('','建筑截图') +
        '<h3 data-edit contenteditable="false">'+esc(n||'建筑名称')+'</h3>' +
        '<p class="desc" data-edit contenteditable="false">在这里写下建筑的介绍：风格、建造时长、使用的材料与亮点。</p>' +
        delBtn + '</figure>';
    },
    member: function(n){
      return '<article class="item glass">' + imgWrap('sq','成员头像') +
        '<h3 data-edit contenteditable="false">'+esc(n||'Steve_ID')+'</h3>' +
        '<div class="role" data-edit contenteditable="false">分工：主建筑师</div>' +
        delBtn + '</article>';
    }
  };

  function initGrids(){
    $('#modGrid').innerHTML  = ['模组 A','模组 B','模组 C'].map(tpl.mod).join('');
    $('#galGrid').innerHTML  = ['中央城堡','海上灯塔','山间村落'].map(tpl.gal).join('');
    $('#teamGrid').innerHTML = ['Steve_01','Alex_02','Creeper_03','Herobrine_04'].map(function(n,i){return tpl.member(n)}).join('');
  }

  /* ============ 状态应用 ============ */
  function setEditing(on){
    editing = on;
    document.body.classList.toggle('editing', on);
    $$('[data-edit]').forEach(function(el){ el.setAttribute('contenteditable', on ? 'true' : 'false'); });
    $$('.field input').forEach(function(i){ i.readOnly = !on; });
    $('#authBtn').textContent = on ? '🔓 退出编辑' : '🔑';
  }
  function syncInputs(){
    $$('.field input').forEach(function(i){ i.setAttribute('value', i.value); });
  }

  /* ============ 初始化 ============ */
  var saved = null;
  try{ saved = localStorage.getItem(KEY); }catch(e){}
  if(saved){ app.innerHTML = saved; } else { initGrids(); }
  setEditing(false);

  /* 图片加载状态 */
  document.addEventListener('error', function(e){
    var t = e.target;
    if(t && t.tagName === 'IMG' && t.getAttribute('src')){ var w = t.closest('.img-wrap'); if(w) w.classList.add('broken'); }
  }, true);
  document.addEventListener('load', function(e){
    var t = e.target;
    if(t && t.tagName === 'IMG'){ var w = t.closest('.img-wrap'); if(w) w.classList.remove('broken'); }
  }, true);

  /* 粘贴纯文本 */
  document.addEventListener('paste', function(e){
    var el = e.target.closest && e.target.closest('[data-edit]');
    if(!el || !editing) return;
    e.preventDefault();
    var txt = (e.clipboardData || window.clipboardData).getData('text/plain');
    document.execCommand('insertText', false, txt);
  });

  /* ============ 登录 ============ */
  var lock = $('#lock'), pwd = $('#pwd');
  function tryLogin(){
    if(pwd.value === PASSWORD){
      lock.classList.add('hide'); pwd.value=''; $('#lockMsg').textContent='';
      setEditing(true); toast('✓ 已进入编辑模式');
    }else{
      $('#lockMsg').textContent = '密码错误，请重试';
      var c = $('.lock-card'); c.classList.remove('shake'); void c.offsetWidth; c.classList.add('shake');
      pwd.select();
    }
  }
  $('#btnLogin').addEventListener('click', tryLogin);
  pwd.addEventListener('keydown', function(e){ if(e.key === 'Enter') tryLogin(); });
  function closeLock(){ lock.classList.add('hide'); pwd.value=''; $('#lockMsg').textContent=''; }
  $('#btnGuest').addEventListener('click', closeLock);
  lock.addEventListener('click', function(e){ if(e.target === lock) closeLock(); });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && !lock.classList.contains('hide')) closeLock(); });
  $('#authBtn').addEventListener('click', function(){
    if(editing){ setEditing(false); toast('已退出编辑，当前为只读模式'); }
    else{ lock.classList.remove('hide'); setTimeout(function(){pwd.focus()},50); }
  });

  /* ============ 点击事件（事件委托） ============ */
  document.addEventListener('click', function(e){
    var lb = $('#lightbox');
    if(lb.classList.contains('open')){ lb.classList.remove('open'); return; }

    var btn = e.target.closest('[data-act]');
    if(!btn){
      var img = e.target.closest('#galGrid .img-wrap img');
      if(img && !editing && img.getAttribute('src')){
        $('#lightbox img').src = img.src; lb.classList.add('open');
      }
      return;
    }
    var act = btn.getAttribute('data-act');

    if(act === 'copy'){
      e.stopPropagation();
      var im = btn.closest('.img-wrap').querySelector('img');
      var src = im ? im.src : '';
      if(!im || !im.getAttribute('src')){ toast('src 为空，请先填入图片链接', true); return; }
      copyText(src).then(function(ok){ ok ? toast('✓ 已复制') : toast('复制失败，请手动复制', true); });
      return;
    }

    if(!editing) return;  // 以下均为编辑功能，访客无效

    if(act === 'swap'){
      var im2 = btn.closest('.img-wrap').querySelector('img');
      var url = prompt('请输入图片链接（图床 URL）：', im2.getAttribute('src') || '');
      if(url !== null){
        im2.parentNode.classList.remove('broken');
        im2.setAttribute('src', url.trim());
        toast(url.trim() ? '图片链接已更新' : '已清空图片链接');
      }
    }else if(act === 'flip'){
      btn.closest('.split').classList.toggle('reverse');
    }else if(act === 'add-mod'){ add('#modGrid', tpl.mod());
    }else if(act === 'add-gal'){ add('#galGrid', tpl.gal());
    }else if(act === 'add-member'){ add('#teamGrid', tpl.member());
    }else if(act === 'del'){
      if(confirm('确定删除这一项吗？')) btn.closest('.item').remove();
    }else if(act === 'save'){
      syncInputs();
      try{ localStorage.setItem(KEY, app.innerHTML); toast('✓ 已保存到本浏览器'); }
      catch(err){ toast('保存失败：存储空间不足或被禁用', true); }
    }else if(act === 'bg'){
      var cur = $('#bg').style.getPropertyValue('--bg-image');
      var m = cur.match(/url\("?(.*?)"?\)/);
      var u = prompt('请输入背景图链接（留空则恢复默认深色背景）：', m ? m[1] : '');
      if(u !== null){
        u = u.trim();
        if(u) $('#bg').style.setProperty('--bg-image', 'url("'+u.replace(/"/g,'%22')+'")');
        else $('#bg').style.removeProperty('--bg-image');
      }
    }else if(act === 'export'){
      exportHTML();
    }else if(act === 'reset'){
      if(confirm('将清除本浏览器已保存的修改并恢复初始内容，确定吗？')){
        try{ localStorage.removeItem(KEY); }catch(err){}
        location.reload();
      }
    }
  });

  function add(sel, html){
    var g = $(sel); g.insertAdjacentHTML('beforeend', html);
    setEditing(true);
    g.lastElementChild.scrollIntoView({behavior:'smooth', block:'center'});
  }

  /* ============ 导出 ============ */
  function exportHTML(){
    syncInputs();
    var clone = document.documentElement.cloneNode(true);
    $$('[contenteditable]', clone).forEach(function(el){ el.setAttribute('contenteditable','false'); });
    $$('.field input', clone).forEach(function(i){ i.setAttribute('readonly',''); });
    var body = clone.querySelector('body'); body.classList.remove('editing');
    var l = clone.querySelector('#lock'); if(l) l.classList.add('hide');
    var lb = clone.querySelector('#lightbox'); if(lb) lb.classList.remove('open');
    var t = clone.querySelector('#toast'); if(t){ t.className=''; t.textContent=''; }
    var a = clone.querySelector('#authBtn'); if(a) a.textContent = '🔑';
    var html = '<!DOCTYPE html>\n' + clone.outerHTML;
    var blob = new Blob([html], {type:'text/html;charset=utf-8'});
    var link = document.createElement('a');
    link.href = URL.createObjectURL(blob); link.download = 'minecraft-showcase.html';
    document.body.appendChild(link); link.click(); link.remove();
    setTimeout(function(){ URL.revokeObjectURL(link.href); }, 2000);
    toast('✓ 已导出 HTML 文件');
  }
})();
</script>


