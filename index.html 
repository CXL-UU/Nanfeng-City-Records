<style>
:root{
  --glass:rgba(18,22,34,.55);
  --stroke:rgba(255,255,255,.2);
  --accent:#5dd35d;
  --accent-d:#2f8f2f;
  --gold:#ffd24a;
  --text:#eef2ff;
  --muted:#aab3c8;
  --pixel-font:'Press Start 2P','Courier New',ui-monospace,monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei","Noto Sans SC",sans-serif;
  color:var(--text);background:#0a0e16;line-height:1.7;min-height:100vh;
  -webkit-text-size-adjust:100%;
}
/* ===== 背景 ===== */
.bg{
  position:fixed;inset:0;z-index:-2;
  background-image:var(--bg-image,none),
    linear-gradient(180deg,#0d1b2a 0%,#13233a 45%,#1b3a2a 75%,#2b2118 100%);
  background-size:cover;background-position:center;
}
.bg::after{
  content:"";position:absolute;inset:0;
  background-image:
    linear-gradient(rgba(255,255,255,.035) 2px,transparent 2px),
    linear-gradient(90deg,rgba(255,255,255,.035) 2px,transparent 2px);
  background-size:32px 32px;
  background-color:rgba(5,8,14,.35);
}
/* ===== 通用玻璃 + 像素 ===== */
.glass{
  background:var(--glass);
  -webkit-backdrop-filter:blur(16px) saturate(140%);
  backdrop-filter:blur(16px) saturate(140%);
  border:2px solid var(--stroke);
  border-radius:4px;
  box-shadow:6px 6px 0 rgba(0,0,0,.45),inset 0 0 0 2px rgba(255,255,255,.04);
}
.px-btn{
  font-family:inherit;font-size:.85rem;font-weight:700;color:#fff;cursor:pointer;
  background:var(--accent-d);border:2px solid #0b1a0b;padding:.45rem .9rem;border-radius:0;
  box-shadow:inset -3px -3px 0 rgba(0,0,0,.35),inset 3px 3px 0 rgba(255,255,255,.35);
  text-shadow:2px 2px 0 rgba(0,0,0,.4);
  display:inline-flex;align-items:center;gap:.35rem;line-height:1.2;
}
.px-btn:hover{background:#3aa43a}
.px-btn:active{transform:translateY(2px)}
.px-btn.danger{background:#a33}
.px-btn.danger:hover{background:#c44}
.px-btn.gray{background:#555}
.px-btn.gray:hover{background:#6a6a6a}
.px-btn.small{font-size:.75rem;padding:.3rem .6rem}

/* ===== 顶部导航 ===== */
header.top{
  position:sticky;top:0;z-index:50;
  display:flex;align-items:center;justify-content:space-between;gap:1rem;
  padding:.7rem 1.2rem;margin:0;border-radius:0;border-width:0 0 2px 0;
}
.brand{display:flex;align-items:center;gap:.7rem;min-width:0}
.cube{
  width:28px;height:28px;flex:none;image-rendering:pixelated;
  background:
    linear-gradient(#5dd35d 0 35%,#7a5230 35% 100%);
  border:2px solid #000;
  box-shadow:inset -3px -3px 0 rgba(0,0,0,.3),inset 3px 3px 0 rgba(255,255,255,.25);
}
.logo{
  width:44px;height:44px;flex:none;display:block;image-rendering:pixelated;
  border:2px solid #000;box-shadow:3px 3px 0 rgba(0,0,0,.5);
}
.logo.big{width:96px;height:96px;margin:0 auto 1rem;border-width:3px;box-shadow:5px 5px 0 rgba(0,0,0,.5)}
.brand .name{display:flex;flex-direction:column;min-width:0}
.brand h1{font-size:1.5rem;line-height:1.15;letter-spacing:.2em;text-shadow:3px 3px 0 #1b5e20;white-space:nowrap}
.brand .sub{font-size:.72rem;color:var(--gold);letter-spacing:.12em;text-shadow:1px 1px 0 #000;white-space:nowrap}
nav.menu{display:flex;gap:.3rem;overflow-x:auto;scrollbar-width:none}
nav.menu::-webkit-scrollbar{display:none}
nav.menu a{
  color:var(--text);text-decoration:none;font-size:.9rem;white-space:nowrap;
  padding:.35rem .7rem;border:2px solid transparent;
}
nav.menu a:hover{border-color:var(--accent);background:rgba(93,211,93,.15);color:#fff}

/* ===== 主体 ===== */
main{max-width:1100px;margin:0 auto;padding:1.5rem 1rem 6rem}
section{padding:1.6rem 0;scroll-margin-top:80px}
.hero{text-align:center;padding:3rem 1.2rem;margin-top:1rem}
.hero .pixel-tag{font-family:var(--pixel-font);font-size:.7rem;color:var(--gold);letter-spacing:.1em;text-shadow:2px 2px 0 #000}
.hero h2{font-size:clamp(1.6rem,5vw,2.8rem);margin:.8rem 0;text-shadow:4px 4px 0 #1b5e20,8px 8px 0 rgba(0,0,0,.4)}
.hero p{color:var(--muted);max-width:640px;margin:0 auto 1.2rem}
.hero .go{display:flex;gap:.8rem;justify-content:center;flex-wrap:wrap}
.hero .go a{text-decoration:none}

.sec-title{
  display:flex;align-items:center;gap:.7rem;margin-bottom:1.1rem;
}
.sec-title::before{
  content:"";width:22px;height:22px;flex:none;
  background:linear-gradient(#5dd35d 0 35%,#7a5230 35% 100%);
  border:2px solid #000;box-shadow:inset -3px -3px 0 rgba(0,0,0,.3),inset 3px 3px 0 rgba(255,255,255,.25);
}
.sec-title h2{font-size:1.4rem;text-shadow:3px 3px 0 rgba(0,0,0,.55);flex:1}
.sec-title .en{font-family:var(--pixel-font);font-size:.6rem;color:var(--gold);text-shadow:2px 2px 0 #000;display:block;margin-bottom:.4rem}

/* 左右图文 */
.split{display:grid;grid-template-columns:1fr 1fr;gap:1.4rem;padding:1.2rem;align-items:center}
.split.reverse .media{order:2}
.split .text h3{font-size:1.2rem;margin-bottom:.5rem;color:var(--gold);text-shadow:2px 2px 0 #000}
.split .text p,.split .text li{color:#dfe5f5}
.split .text ul{padding-left:1.2rem;margin:.5rem 0}
.split .text li::marker{color:var(--accent)}
.tools{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.9rem}

/* 图片占位 / 容器 */
.img-wrap{
  position:relative;width:100%;aspect-ratio:16/10;overflow:hidden;
  border:3px solid #000;box-shadow:4px 4px 0 rgba(0,0,0,.5);
  background:conic-gradient(#2a3140 25%,#222938 0 50%,#2a3140 0 75%,#222938 0) 0 0/24px 24px;
}
.img-wrap.sq{aspect-ratio:1/1}
.img-wrap.wide{aspect-ratio:4/3}
.img-wrap::before{
  content:"IMG\A在此填入 src 图片链接";white-space:pre;text-align:center;
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  font-size:.75rem;color:#7d879c;line-height:1.8;z-index:0;padding:.5rem;
}
.img-wrap img{
  position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;z-index:1;
  image-rendering:auto;
}
.img-wrap.sq img{image-rendering:pixelated}
.img-wrap img[src=""],.img-wrap.broken img{visibility:hidden}
.img-wrap.broken::before{content:"图片加载失败\A请检查 src 链接";color:#e88}

.copy-btn,.swap-btn{
  position:absolute;z-index:3;top:8px;
  font-family:inherit;font-size:.72rem;font-weight:700;color:#fff;cursor:pointer;
  padding:.3rem .55rem;border:2px solid #000;border-radius:0;
  background:rgba(20,26,40,.82);
  -webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);
  box-shadow:inset -2px -2px 0 rgba(0,0,0,.4),inset 2px 2px 0 rgba(255,255,255,.25);
  opacity:0;transition:opacity .15s;
}
.copy-btn{right:8px}
.swap-btn{left:8px}
.img-wrap:hover .copy-btn,.img-wrap:hover .swap-btn,.copy-btn:focus,.swap-btn:focus{opacity:1}
.copy-btn:hover{background:var(--accent-d)}
.swap-btn:hover{background:#b8860b}
@media (hover:none){.copy-btn,.swap-btn{opacity:.92}}

/* 网格 */
.grid{display:grid;gap:1.2rem}
#modGrid{grid-template-columns:repeat(auto-fill,minmax(230px,1fr))}
#galGrid{grid-template-columns:repeat(auto-fill,minmax(300px,1fr))}
#teamGrid{grid-template-columns:repeat(auto-fill,minmax(200px,1fr))}
.item{padding:.9rem;position:relative;display:flex;flex-direction:column;gap:.6rem}
.item h3{font-size:1.05rem;text-shadow:2px 2px 0 #000}
.item .desc{color:#d6dcee;font-size:.92rem}
.item .role{color:var(--gold);font-size:.88rem}
.team .item{text-align:center;align-items:stretch}
.team .img-wrap{max-width:140px;margin:0 auto}
.field{display:flex;align-items:center;gap:.5rem;font-size:.85rem}
.field span{color:var(--muted);white-space:nowrap;min-width:3.2em}
.field input{
  flex:1;min-width:0;font:inherit;color:#fff;background:rgba(0,0,0,.4);
  border:2px solid #000;border-radius:0;padding:.3rem .5rem;
  box-shadow:inset 2px 2px 0 rgba(0,0,0,.5);
}
.field input:focus{outline:2px solid var(--accent)}
.field input[readonly]{background:rgba(0,0,0,.25);cursor:default;outline:none}
.field.price input{color:var(--gold)}
.del{position:absolute;right:6px;bottom:6px}
.item .del{position:static;align-self:flex-end}

/* 编辑态 */
.edit-only{display:none}
body.editing .edit-only{display:inline-flex}
body.editing .tools.edit-only{display:flex}
body.editing [data-edit]{outline:1px dashed rgba(255,210,74,.45);outline-offset:2px;cursor:text}
body.editing [data-edit]:focus{outline:2px solid var(--gold);background:rgba(255,255,255,.05)}
body.editing .img-wrap .copy-btn,body.editing .img-wrap .swap-btn{opacity:.95}
body.editing .copy-btn{top:8px}
body.editing .swap-btn{display:block}
[data-edit]{caret-color:var(--gold)}

/* 编辑工具条 & 登录按钮 */
#toolbar{
  position:fixed;left:50%;bottom:16px;transform:translateX(-50%);z-index:80;
  flex-wrap:wrap;gap:.5rem;justify-content:center;padding:.6rem .8rem;max-width:calc(100vw - 24px);
}
body.editing #toolbar{display:flex}
#authBtn{
  position:fixed;right:10px;bottom:10px;z-index:81;
  width:30px;height:30px;padding:0;justify-content:center;
  font-size:.8rem;opacity:.18;transition:opacity .2s;
}
#authBtn:hover,#authBtn:focus{opacity:1}
body.editing #authBtn{bottom:auto;top:70px;width:auto;height:auto;padding:.3rem .6rem;opacity:1}

footer{text-align:center;color:var(--muted);font-size:.82rem;padding:1.5rem 1rem 5rem}

/* Toast */
#toast{
  position:fixed;left:50%;top:84px;transform:translate(-50%,-20px);z-index:200;
  background:#1f7a1f;color:#fff;font-weight:700;padding:.55rem 1.1rem;border:2px solid #000;
  box-shadow:4px 4px 0 rgba(0,0,0,.5),inset -3px -3px 0 rgba(0,0,0,.3),inset 3px 3px 0 rgba(255,255,255,.3);
  opacity:0;pointer-events:none;transition:.25s;max-width:90vw;text-align:center;
}
#toast.show{opacity:1;transform:translate(-50%,0)}
#toast.err{background:#9a2a2a}

/* 密码锁 */
#lock{
  position:fixed;inset:0;z-index:300;display:flex;align-items:center;justify-content:center;padding:1rem;
  background:rgba(4,6,12,.7);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
}
#lock.hide{display:none}
.lock-card{width:100%;max-width:380px;padding:1.6rem;text-align:center}
.lock-card .cube{width:44px;height:44px;margin:0 auto 1rem}
.lock-card h2{font-size:1.2rem;text-shadow:3px 3px 0 #1b5e20;margin-bottom:.3rem}
.lock-card p{color:var(--muted);font-size:.88rem;margin-bottom:1rem}
.lock-card input{
  width:100%;font:inherit;font-size:1rem;color:#fff;text-align:center;letter-spacing:.2em;
  background:rgba(0,0,0,.5);border:2px solid #000;padding:.6rem;margin-bottom:.8rem;border-radius:0;
  box-shadow:inset 3px 3px 0 rgba(0,0,0,.5);
}
.lock-card input:focus{outline:2px solid var(--accent)}
.lock-card .row{display:flex;gap:.6rem;justify-content:center;flex-wrap:wrap}
#lockMsg{min-height:1.4em;color:#ff8a8a;font-size:.85rem;margin-bottom:.6rem}
.shake{animation:shake .35s}
@keyframes shake{20%,60%{transform:translateX(-8px)}40%,80%{transform:translateX(8px)}}

/* 灯箱 */
#lightbox{
  position:fixed;inset:0;z-index:250;display:none;align-items:center;justify-content:center;
  background:rgba(0,0,0,.85);padding:1rem;cursor:zoom-out;
}
#lightbox.open{display:flex}
#lightbox img{max-width:100%;max-height:100%;border:3px solid #000;box-shadow:6px 6px 0 rgba(0,0,0,.6)}

/* ===== 手机自适应 ===== */
@media (max-width:760px){
  header.top{flex-direction:column;align-items:stretch;gap:.4rem;padding:.6rem .8rem}
  .brand h1{font-size:.95rem;white-space:normal}
  nav.menu{padding-bottom:.2rem}
  .split{grid-template-columns:1fr;padding:.9rem}
  .split.reverse .media{order:0}
  .hero{padding:2rem 1rem}
  #galGrid{grid-template-columns:1fr}
  #modGrid{grid-template-columns:repeat(auto-fill,minmax(160px,1fr))}
  #teamGrid{grid-template-columns:repeat(auto-fill,minmax(150px,1fr))}
  .sec-title h2{font-size:1.2rem}
  section{scroll-margin-top:110px}
  body.editing #authBtn{top:auto;bottom:90px}
}
@media (max-width:420px){
  #modGrid,#teamGrid{grid-template-columns:1fr 1fr;gap:.7rem}
  .item{padding:.6rem}
}
</style>
</head>
